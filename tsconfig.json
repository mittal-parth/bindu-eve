{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node", "eve/workflow-modules"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./apps/web/*"]
    }
  },
  "include": [
    "agent/**/*.ts",
    "daemon/**/*.ts",
    "evals/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts"
  ]
}
